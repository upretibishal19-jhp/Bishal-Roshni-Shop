      "description": "Registered retail and wholesale customers"
    },
    "/salesInvoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/SalesInvoice" },
      "description": "Sales invoices with split payment allocations"
    },
    "/customerCreditLedger/{entryId}": {
      "schema": { "$ref": "#/entities/CustomerCreditEntry" },
      "description": "Immutable customer credit and recovery ledger"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Supplier profiles and payables"
    },
    "/purchaseOrders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Supplier purchase orders"
    },
    "/goodsReceipts/{grnId}": {
      "schema": { "$ref": "#/entities/GoodsReceipt" },
      "description": "Goods received notes against POs"
    },
    "/supplierPayments/{paymentId}": {
      "schema": { "$ref": "#/entities/SupplierPayment" },
      "description": "Immutable supplier payment ledger"
    },
    "/stockTransfers/{transferId}": {
      "schema": { "$ref": "#/entities/StockTransfer" },
      "description": "Multi-store stock transfer records"
    },
    "/onlineOrders/{orderId}": {
      "schema": { "$ref": "#/entities/OnlineOrder" },
      "description": "Phone, WhatsApp, Messenger, and online orders"
    },
    "/wasteRecords/{wasteId}": {
      "schema": { "$ref": "#/entities/WasteRecord" },
      "description": "Immutable damaged and expired waste records"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Store operating expenses"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable system audit trail"
    },
    "/dayCloses/{dayCloseId}": {
      "schema": { "$ref": "#/entities/DayClose" },
      "description": "Daily store end-of-day cash drawer and sales reconciliation records"
    },
    "/comboOffers/{comboId}": {
      "schema": { "$ref": "#/entities/ComboOffer" },
      "description": "Special combo bundle offers for monthly family stock, weekends, festivals, and custom offers"
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Startup Firestore connection validation"
    }
  }
