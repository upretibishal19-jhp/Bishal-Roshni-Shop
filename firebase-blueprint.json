  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Global business configuration"
    },
    "/employees/{employeeUid}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Active ERP staff profiles and role permissions"
    },
    "/employeeInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/EmployeeInvite" },
      "description": "Owner-authorized employee invitations"
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Multi-store branch directory"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Master product catalog"
    },
    "/stockBatches/{batchId}": {
      "schema": { "$ref": "#/entities/StockBatch" },
      "description": "Store-level FIFO inventory batches"
    },
    "/stockLedger/{ledgerId}": {
